            "en": "La",
            "es": "La"
          }
        }
      ],
      "correctAnswer": [
        "opt-do"
      ],
      "remediation": {
        "explanation": {
          "en": "'C' corresponds to 'Do' in the Solfège system.",
          "es": "'C' corresponde a 'Do' en el sistema de Solfeo."
        },
        "hint": {
          "en": "Series: C=Do, D=Re, E=Mi, F=Fa, G=Sol, A=La, B=Si.",
